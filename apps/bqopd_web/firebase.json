{
  "hosting": {
    "target": "jaspr_app",
    "public": "build/jaspr",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "bqopd-web",
          "region": "us-central1"
        }
      }
    ]
  }
}