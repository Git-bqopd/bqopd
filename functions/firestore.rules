rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

// ===========================================================================
// Role Helpers — Sourced exclusively from Firebase Auth Custom Claims
// ===========================================================================
function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn() && request.auth.token.get('admin', false) == true;
}

function isModerator() {
  return isSignedIn() && request.auth.token.get('moderator', false) == true;
}

function isCurator() {
  return isSignedIn() && request.auth.token.get('curator', false) == true;
}

function isTerminalGM() {
  return isSignedIn() && request.auth.token.get('terminalGM', false) == true;
}

// Any authorized staff member (Admin, Moderator, or Curator)
function isStaff() {
  return isAdmin() || isModerator() || isCurator();
}

// ===========================================================================
// Users — Private Account System Data (Mailing Address, Email)
// STRICT PRIVACY: User own-UID ONLY. No staff member (even Admin) can read
// other users' physical addresses through client SDK queries.
// ===========================================================================
match /Users/{userDocId}/{allPaths=**} {
  allow read, write: if isSignedIn() && request.auth.uid == userDocId;
}

// ===========================================================================
// Profiles — Public Identity & Directory
// Single profile reads are public; collection-wide scraping/listing is blocked.
// ===========================================================================
match /profiles/{profileId} {
  // 1. Read: Individual get is public; bulk list is disallowed
  allow get: if true;
  allow list: if false;

  // 2. Full Write: Profile owner, assigned managers (managed profiles), or Admin
  allow write: if isSignedIn() && (
    request.auth.uid == profileId ||
    (resource != null && request.auth.uid in resource.data.get('managers', [])) ||
    (resource == null && request.auth.uid in request.resource.data.get('managers', [])) ||
    isAdmin()
  );

  // 3. Partial Update: Social counter increments only
  allow update: if isSignedIn() &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'followingCount', 'updatedAt']);

  // 4. Followers/Following Subcollections
  match /followers/{followerId} {
    allow get: if true;
    allow list: if false;
    allow write: if isSignedIn() && request.auth.uid == followerId;
  }
  match /following/{targetId} {
    allow get: if true;
    allow list: if false;
    allow write: if isSignedIn() && request.auth.uid == profileId;
  }
}

// ===========================================================================
// Roles Mirror & Audit Log (Settings Console)
// ===========================================================================
match /roles/{userId} {
  allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
  allow list: if isAdmin();
  // Writes are strictly performed by the set_user_roles Cloud Function (Admin SDK)
  allow write: if false;
}

match /audit_log/{logId} {
  allow read: if isAdmin();
  allow write: if false;
}

// ===========================================================================
// Images / UGC Pool
// ===========================================================================
match /images/{id} {
  // Public reads allowed for published items; draft items restricted to owner & moderators
  allow get: if resource.data.get('status', 'draft') == 'published' ||
                (isSignedIn() && (resource.data.uploaderId == request.auth.uid || isModerator()));
  allow list: if false;

  // Create: Must be signed in and must be the uploader
  allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;

  // Update: Uploader, Moderator, Curator (curated items), or Admin
  allow update: if isSignedIn() && (
    resource.data.uploaderId == request.auth.uid ||
    isModerator() ||
    isAdmin() ||
    (isCurator() && resource.data.get('isCurated', false) == true) ||
    // Allow bounded engagement counter updates from any authenticated user
    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'usedInFanzines', 'likeCount', 'commentCount',
      'regListCount', 'anonListCount', 'regGridCount', 'anonGridCount'
    ])
  );

  allow delete: if isSignedIn() && (
    resource.data.uploaderId == request.auth.uid || isAdmin() || isModerator()
  );
}

// ===========================================================================
// Fanzines (Folios) & Pages Subcollection
// ===========================================================================
match /fanzines/{id} {
  function isFanzineOwner() {
    return isSignedIn() && resource.data.ownerId == request.auth.uid;
  }
  function isFanzineEditor() {
    return isSignedIn() && (
      (isModerator() && request.auth.uid in resource.data.get('editors', [])) ||
      resource.data.get('editorId', '') == request.auth.uid
    );
  }
  function isFanzineCurator() {
    return isSignedIn() && isCurator() && request.auth.uid in resource.data.get('curators', []);
  }

  // Published fanzines are public; drafts are limited to owner, editors, curators, or moderators
  allow get: if resource.data.get('isLive', false) == true ||
                isFanzineOwner() || isFanzineEditor() || isFanzineCurator() || isModerator();
  allow list: if false;

  allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
  allow update: if isFanzineOwner() || isFanzineEditor() || isFanzineCurator() || isModerator() || isAdmin();
  allow delete: if isFanzineOwner() || isAdmin();

  match /pages/{pageId} {
    allow get: if true;
    allow list: if true;
    allow write: if isFanzineOwner() || isFanzineEditor() || isFanzineCurator() || isModerator() || isAdmin();
  }
}

// ===========================================================================
// Shortcodes & Usernames — Immutable once registered, Admin can manage
// ===========================================================================
match /shortcodes/{id} {
  allow get: if true;
  allow list: if false;
  // Create only if not already existing
  allow create: if isSignedIn() && !exists(/databases/$(database)/documents/shortcodes/$(id));
  allow update, delete: if isAdmin();
}

match /usernames/{handle} {
  allow get: if true;
  allow list: if false;
  allow create: if isSignedIn()
                && !exists(/databases/$(database)/documents/usernames/$(handle))
                && !exists(/databases/$(database)/documents/shortcodes/$(handle));
  allow update: if isSignedIn() && (
    resource.data.uid == request.auth.uid ||
    (exists(/databases/$(database)/documents/profiles/$(resource.data.uid)) &&
     request.auth.uid in get(/databases/$(database)/documents/profiles/$(resource.data.uid)).data.get('managers', [])) ||
    isAdmin()
  );
  allow delete: if isAdmin();
}

// ===========================================================================
// Series
// ===========================================================================
match /series/{seriesId} {
  allow get: if true;
  allow list: if true;
  allow write: if isStaff();
}

// ===========================================================================
// App Settings
// ===========================================================================
match /app_settings/{docId} {
  allow read: if true;
  allow write: if isAdmin();
}

// ===========================================================================
// Terminal Canonical Single World & Game Artifacts
// ===========================================================================
match /artifacts/{appId}/public/data/terminal_world/{docId} {
  allow get: if true;
  allow list: if false;
  allow write: if isTerminalGM();
}

match /artifacts/{appId}/public/data/game_characters/{charId} {
  allow read: if true;
  allow create: if isSignedIn();
  allow update: if isSignedIn() && (
    resource.data.ownerId == request.auth.uid || isTerminalGM()
  );
  allow delete: if isTerminalGM() || isAdmin();
}

match /artifacts/{appId}/public/data/game_battles/{battleId} {
  allow read: if true;
  allow create: if isSignedIn();
  allow update, delete: if isTerminalGM() || isAdmin();
}

match /artifacts/{appId}/public/data/comments/{commentId} {
  allow read: if true;
  allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
  allow update: if isSignedIn() && (
    resource.data.authorUid == request.auth.uid || isModerator() || isAdmin()
  );
  allow delete: if isSignedIn() && (
    resource.data.authorUid == request.auth.uid || isModerator() || isAdmin()
  );
}

match /artifacts/{appId}/public/data/view_logs/{viewId} {
  allow get, create: if isSignedIn();
  allow list: if isStaff();
}

match /artifacts/{appId}/public/data/series/{seriesId} {
  allow read: if true;
  allow write: if isStaff();
}

// ===========================================================================
// Default Deny Fallback
// ===========================================================================
match /{document=**} {
  allow read, write: if false;
}

}
}
