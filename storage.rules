rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------------------
    // Helper Functions — Sourced directly from Auth Custom Claims
    // ---------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    function isModerator() {
      return isAuthenticated() && request.auth.token.get('moderator', false) == true;
    }

    function isCurator() {
      return isAuthenticated() && request.auth.token.get('curator', false) == true;
    }

    function isStaff() {
      return isAdmin() || isModerator() || isCurator();
    }

    function isValidImage() {
      return request.resource.size < 20 * 1024 * 1024
          && (request.resource.contentType.matches('image/(webp|jpeg|jpg|png|gif)') || request.resource.contentType.matches('image/.*'));
    }

    function isValidPdf() {
      return request.resource.size < 100 * 1024 * 1024
          && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
    }

    // ---------------------------------------------------------------------------
    // 1. User Personal Uploads & Folio Multi-Scale Assets
    // ---------------------------------------------------------------------------
    match /uploads/{userId}/{allPaths=**} {
      // Prevent public reads if the userId parameter matches the raw_pdfs pipeline
      allow read: if userId != 'raw_pdfs';
      allow create, update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId) || isModerator() || isAdmin();
    }

    // ---------------------------------------------------------------------------
    // 2. Curator PDF Ingest Pipeline
    // ---------------------------------------------------------------------------
    match /uploads/raw_pdfs/{allPaths=**} {
      allow read: if isStaff();
      allow create, update: if (isCurator() || isModerator() || isAdmin()) && isValidPdf();
      allow delete: if isCurator() || isModerator() || isAdmin();
    }

    // ---------------------------------------------------------------------------
    // 3. Compiled Fanzine Static Pages & Map Covers
    // Static compiled spreads are publicly readable; writes restricted to staff / owners
    // ---------------------------------------------------------------------------
    match /fanzines/{fanzineId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isStaff() || isAuthenticated()) && isValidImage();
      allow delete: if isModerator() || isAdmin();
    }

    // ---------------------------------------------------------------------------
    // 4. Default Deny Fallback
    // ---------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
